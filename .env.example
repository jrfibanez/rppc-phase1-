# Values go in Vercel/Supabase settings, never in git
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # publishable key (sb_publishable_...) or legacy anon key
SUPABASE_SERVICE_ROLE_KEY=              # server-only, never NEXT_PUBLIC_
SETUP_TOKEN=                            # one-time token for /setup (creating the first owner)
REQUIRE_MFA_ROLES=                      # e.g. owner,admin,finance (empty = off)
APP_TIMEZONE=Asia/Manila
